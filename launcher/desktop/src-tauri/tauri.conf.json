{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaLab Studios Launcher",
  "version": "0.6.0",
  "identifier": "dev.novalab.studios.launcher",
  "build": {
    "frontendDist": "../dist-web",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:4177",
    "beforeDevCommand": "node scripts/dev-server.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title":"NovaLab Studios Launcher", "width":1470, "height":910, "minWidth":900, "minHeight":640, "backgroundColor":"#160b25"}],
    "security": {"csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-src 'none'"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {"nsis": {"displayLanguageSelector": false}}
  }
}
